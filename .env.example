# 복사해서 .env.local 로 쓰기 (값은 병찬에게 받기 — .env.local은 gitignore, 절대 커밋 금지)

# Supabase — Project Settings → API Keys (secret 키, 서버 전용)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Groq LLM — 자격 판정·일정 매칭
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b

# 정책 수집 스크립트용 (웹 실행에는 불필요)
ONTONG_YOUTH_API_KEY=            # 온통청년 Open API
DATA_GO_KR_API_KEY=              # 공공데이터포털 (행안부 공공서비스)

# 정책 발견 크론(/api/cron/discover) 웹검색 + 검색바 실시간 미검증 폴백 검색용
TAVILY_API_KEY=                  # tavily.com — 없으면 두 기능 다 자동 생략됨

# 크론(/api/cron/*) 인증 — 설정하면 Vercel이 Authorization: Bearer <값>으로 호출하고 그 외 호출은 401. 미설정이면 인증 없이 통과
CRON_SECRET=

# LLM 제공자 전환 — 기본 groq(무료). Claude로 바꾸려면 아래 3개 설정
LLM_PROVIDER=groq                # groq | anthropic
ANTHROPIC_API_KEY=               # console.anthropic.com에서 발급 (유료 — 입출력 토큰당 과금)
ANTHROPIC_MODEL=claude-opus-5-5  # 또는 claude-sonnet-5-5(1/2 가격), claude-haiku-4-5(1/4 가격)
