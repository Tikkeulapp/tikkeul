# 복사해서 .env.local 로 쓰기 (값은 병찬에게 받기 — .env.local은 gitignore, 절대 커밋 금지)

# Supabase — Project Settings → API Keys (secret 키, 서버 전용)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Groq LLM — 자격 판정·일정 매칭
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b

# 정책 수집 스크립트용 (웹 실행에는 불필요)
ONTONG_YOUTH_API_KEY=            # 온통청년 Open API
DATA_GO_KR_API_KEY=              # 공공데이터포털 (행안부 공공서비스)
