{
  "permissions": {
    "deny": [
      "Read(./.env.local)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.local/bin:$PATH\" \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/stop-verify.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.local/bin:$PATH\" \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/guard-bash.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.local/bin:$PATH\" \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/tdd-guard.sh"
          }
        ]
      }
    ]
  }
}
